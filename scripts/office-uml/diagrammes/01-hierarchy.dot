digraph G { graph [bgcolor="white" pad=.25 nodesep=.5 ranksep=.65 fontname="Arial" fontsize=20 fontcolor="#005067" labelloc=t label="Les 14 types de diagrammes UML"]; node [fontname="Arial" fontsize=16 color="#005067" fontcolor="#122F37" fillcolor="white" style=filled penwidth=1.5 margin=".16,.10"]; edge [fontname="Arial" fontsize=13 color="#005067" fontcolor="#122F37" penwidth=1.4 arrowsize=.8 arrowhead=vee]; 
rankdir=LR;
u [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>UML</B></TD></TR></TABLE>>];s [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Structure</B></TD></TR></TABLE>>];b [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Comportement</B></TD></TR></TABLE>>];i [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Interaction</B></TD></TR></TABLE>>];
sl [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>7 vues structurelles</B></TD></TR><HR/><TR><TD ALIGN="LEFT">Classes<BR ALIGN="LEFT"/>Objets<BR ALIGN="LEFT"/>Composants<BR ALIGN="LEFT"/>Déploiement<BR ALIGN="LEFT"/>Paquets<BR ALIGN="LEFT"/>Structure composite<BR ALIGN="LEFT"/>Profils</TD></TR></TABLE>>];
bl [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>3 vues comportementales</B></TD></TR><HR/><TR><TD ALIGN="LEFT">Cas d’utilisation<BR ALIGN="LEFT"/>Activités<BR ALIGN="LEFT"/>Machines à états</TD></TR></TABLE>>];
il [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>4 vues d’interaction</B></TD></TR><HR/><TR><TD ALIGN="LEFT">Séquence<BR ALIGN="LEFT"/>Communication<BR ALIGN="LEFT"/>Timing<BR ALIGN="LEFT"/>Vue d’ensemble d’interaction</TD></TR></TABLE>>];
