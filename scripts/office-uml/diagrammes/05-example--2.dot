digraph G { graph [bgcolor="white" pad=.25 nodesep=.5 ranksep=.65 fontname="Arial" fontsize=20 fontcolor="#005067" labelloc=t label="Classes · commande et lignes de commande"]; node [fontname="Arial" fontsize=16 color="#005067" fontcolor="#122F37" fillcolor="white" style=filled penwidth=1.5 margin=".16,.10"]; edge [fontname="Arial" fontsize=13 color="#005067" fontcolor="#122F37" penwidth=1.4 arrowsize=.8 arrowhead=vee]; 
rankdir=LR;
client [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Client</B></TD></TR></TABLE>>];cook [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Cuisinier</B></TD></TR></TABLE>>];driver [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Livreur</B></TD></TR></TABLE>>];
cmd [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Commande</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- dateCommande : DateTime<BR ALIGN="LEFT"/>- statut : String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ calculerTotal() : Decimal</TD></TR></TABLE>>];
line [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>LigneCommande</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- quantité : Integer<BR ALIGN="LEFT"/>- prixUnitaire : Decimal</TD></TR></TABLE>>];
dish [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Plat</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- nom : String<BR ALIGN="LEFT"/>- description : String<BR ALIGN="LEFT"/>- prix : Decimal</TD></TR></TABLE>>];
menu [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Menu</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- dateMiseÀJour : DateTime</TD></TR></TABLE>>];
client -> cmd [label="passe" dir=none taillabel="1" headlabel="0..*"];cook -> cmd [label="prépare" dir=none taillabel="0..*" headlabel="0..*"];driver -> cmd [label="livre" dir=none taillabel="0..1" headlabel="0..*"];
cmd -> line [label="contient" dir=both arrowtail=diamond arrowhead=none taillabel="1" headlabel="1..*"];line -> dish [label="référence" dir=none taillabel="0..*" headlabel="1"];menu -> dish [label="propose" dir=none taillabel="0..*" headlabel="0..*"]; }