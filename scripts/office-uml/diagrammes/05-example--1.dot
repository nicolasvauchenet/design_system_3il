digraph G { graph [bgcolor="white" pad=.25 nodesep=.5 ranksep=.65 fontname="Arial" fontsize=20 fontcolor="#005067" labelloc=t label="Classes · spécialiser les utilisateurs"]; node [fontname="Arial" fontsize=16 color="#005067" fontcolor="#122F37" fillcolor="white" style=filled penwidth=1.5 margin=".16,.10"]; edge [fontname="Arial" fontsize=13 color="#005067" fontcolor="#122F37" penwidth=1.4 arrowsize=.8 arrowhead=vee]; 
user [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B><I>Utilisateur</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT">- nom : String<BR ALIGN="LEFT"/>- email : String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ modifierProfil() : void</TD></TR></TABLE>>];
client [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Client</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- adresse : String</TD></TR></TABLE>>];cook [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Cuisinier</B></TD></TR></TABLE>>];driver [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Livreur</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- position : String<BR ALIGN="LEFT"/>- statut : String</TD></TR></TABLE>>];
user -> client [label="" dir=back arrowtail=empty];user -> cook [label="" dir=back arrowtail=empty];user -> driver [label="" dir=back arrowtail=empty]; }