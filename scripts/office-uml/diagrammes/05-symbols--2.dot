digraph G { graph [bgcolor="white" pad=.25 nodesep=.5 ranksep=.65 fontname="Arial" fontsize=20 fontcolor="#005067" labelloc=t label="Classes · relations et multiplicités"]; node [fontname="Arial" fontsize=16 color="#005067" fontcolor="#122F37" fillcolor="white" style=filled penwidth=1.5 margin=".16,.10"]; edge [fontname="Arial" fontsize=13 color="#005067" fontcolor="#122F37" penwidth=1.4 arrowsize=.8 arrowhead=vee]; 
rankdir=LR; pack=true; packmode="array3";
c [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Client</B></TD></TR></TABLE>>];o [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Commande</B></TD></TR></TABLE>>];c -> o [label="passe" dir=none taillabel="1" headlabel="0..*" labeldistance=2];
child [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Classe spécialisée</B></TD></TR></TABLE>>];parent [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Classe générale</B></TD></TR></TABLE>>];child -> parent [label="généralisation" arrowhead=empty];
impl [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Implémentation</B></TD></TR></TABLE>>];inter [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>«interface»<BR/>Contrat</B></TD></TR></TABLE>>];impl -> inter [label="réalisation" style=dashed arrowhead=empty];
whole [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Tout</B></TD></TR></TABLE>>];part [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Partie</B></TD></TR></TABLE>>];whole -> part [label="composition" dir=both arrowtail=diamond arrowhead=none];
agg [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Ensemble</B></TD></TR></TABLE>>];member [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Élément</B></TD></TR></TABLE>>];agg -> member [label="agrégation partagée" dir=both arrowtail=odiamond arrowhead=none];
use [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Client de service</B></TD></TR></TABLE>>];service [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9" COLOR="#005067"><TR><TD BGCOLOR="#EDF4F5"><B>Service</B></TD></TR></TABLE>>];use -> service [label="dépendance" style=dashed arrowhead=vee]; }